# FastTTSR Environment Configuration

# Host port mapping (external port)
HOST_PORT=9090

# Internal HTTP port (container)
HTTP_PORT=8080

# Internal HTTPS port (container) - leave empty to disable HTTPS
HTTPS_PORT=

# Host port mapping for HTTPS (external port, only relevant when HTTPS_PORT is set)
HOST_HTTPS_PORT=5769

# PFX certificate password - generate a cert first with ./generate-cert.sh <lan-hostname-or-ip>
CERT_PASSWORD=

# Model cache directory (inside container)
MODEL_CACHE_DIR=/cache

# Espeak data directory
ESPEAK_DATA_DIR=/app/assets/espeak-ng-data

# Model idle timeout in seconds (0 to disable automatic model release)
# After this period of inactivity, models are released from memory to save resources
MODEL_IDLE_TIMEOUT_SECONDS=60
