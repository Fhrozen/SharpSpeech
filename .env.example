# FastTTSR Environment Configuration

# Host port mapping (external port)
HOST_PORT=9090

# Internal HTTP port (container)
HTTP_PORT=8080

# Internal HTTPS port (container) - leave empty to disable HTTPS
HTTPS_PORT=

# Model cache directory (inside container)
MODEL_CACHE_DIR=/cache

# Espeak data directory
ESPEAK_DATA_DIR=/app/assets/espeak-ng-data
