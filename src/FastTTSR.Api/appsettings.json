{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ModelIdleMonitor": {
    "IdleTimeoutSeconds": 60,
    "CheckIntervalSeconds": 10
  },
  "WorkerOptions": {
    "Enabled": true,
    "ExecutablePath": "./FastTTSR.Worker",
    "IdleTimeoutSeconds": 60,
    "PortRangeStart": 50051,
    "MaxPortAttempts": 100,
    "StartupTimeoutSeconds": 30
  }
}
